# Salin ke .env.local lalu isi nilainya.
# Panduan lengkap: docs/manual-setup.md §7
# Jangan pernah commit file berisi nilai asli.

# Database (Neon)
DATABASE_URL=                          # pooled, dipakai runtime app
DATABASE_URL_UNPOOLED=                 # direct, dipakai drizzle-kit, seed, backup

# Firebase (auth owner)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Sesi dan pemilik
SESSION_SECRET=                        # minimal 32 byte acak
OWNER_EMAIL=

# Cloudinary (foto)
CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=      # sama dengan cloud name, dipakai loader gambar
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Cloudflare R2 (video dan backup)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=olu-media
R2_PUBLIC_BASE=

# Opsional
TELEGRAM_BOT_TOKEN=
NEXT_PUBLIC_GA_ID=
